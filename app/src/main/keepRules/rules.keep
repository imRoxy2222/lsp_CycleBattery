# ==== libxposed 模块 ====
-adaptresourcefilecontents META-INF/xposed/java_init.list
-keep class io.github.imroxy2222.lsp_coloros17cyclebattery.xposed.MainHook { *; }
-keep class io.github.imroxy2222.lsp_coloros17cyclebattery.xposed.CameraRingView { *; }
-keep class io.github.imroxy2222.lsp_coloros17cyclebattery.xposed.BatteryConfig { *; }
-keepclassmembers class io.github.imroxy2222.lsp_coloros17cyclebattery.xposed.** { *; }

# ==== libxposed service ====
-dontwarn io.github.libxposed.service.**